# kitty config
# font_family      JetBrainsMonoNerdFont
# bold_font        auto
# italic_font      auto
# bold_italic_font auto
font_size	 9
background_opacity 0.75
dynamic_background_opacity yes


cursor #06f497
cursor_shape block
cursor_blink_interval -1 linear ease-out
cursor_stop_blinking_after 15
cursor_trail 1
cursor_trail_decay 0.05 0.25
cursor_trail_start_threshold 1
cursor_trail_color #1ce0c0
						


scrollback_lines 5000
scroll_unhide disabled
scrollbar scrolled
scrollbar_width 1
scrollbar_hover_width 3
scrollbar_radius 1
scrollbar_gap 1
scrollbar_handle_opacity 0.1
scrollbar_hitbox_expansion 2
scrollbar_track_opacity 0.01
scrollbar_track_hover_opacity 0.025
pixel_scroll yes


enable_audio_bell no
visual_bell_duration 0.5 cubic-bezier(0, 0, 0.58, 1)
visual_bell_color #1b5f78
window_alert_on_bell yes
bell_on_tab "🔔 "
command_on_bell pw-play /usr/share/sounds/freedesktop/stereo/bell.oga


window_border_width 2pt
draw_minimal_borders no
draw_window_borders_for_single_window no
window_margin_width 1
single_window_margin_width 1
window_padding_width 1
single_window_padding_width 1
remember_window_size no

active_border_color #5c3d67
inactive_border_color #322e3f
bell_border_color #ca9ee6




tab_bar_style powerline
tab_bar_min_tabs 1
tab_activity_symbol 🔸_
tab_powerline_style round
#ab_bar_margin_width 20
tab_bar_align center
tab_bar_show_new_tab_button yes


tab_bar_background #767676
active_tab_foreground   #ffffff
active_tab_background   #5c3d67
active_tab_font_style   normal
inactive_tab_foreground #000000
inactive_tab_background #767676
inactive_tab_font_style normal


allow_remote_control yes

# BEGIN_KITTY_FONTS
font_family      family="IosevkaTerm Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
