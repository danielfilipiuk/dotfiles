//*///////////////////////////*/
//*    WAYBAR CONFIG */
//*///////////////////////////*/

// -*- mode: jsonc -*-
{

"name": "Waybar",

"layer": "top", // Waybar at top layer

"output": ["DP-1", "DVI-D-1"],

"position": "top", // Waybar position (top|bottom|left|right)

"height": 24, // Waybar height (to be removed for auto height)

//"width": "1280", // Waybar width
    
"spacing": 5, // Gaps between modules (4px)

"expand-left": false,

"expand-right": false, 

"fixed-center": false,

"mode": "dock",

"reload_style_on_change": true,

"margin-top": 5,
"margin-bottom": 5,

"no-center": false,

"markup": true,




///////////////////////////////////////////////////////////////////////////////////////
    // Choose the order of the modules
"modules-left": ["wlr/taskbar"],
	//"ext/workspaces",
        //"hyprland/submap",
	//  "hyprland/window"
	//"hyprland/workspaces"

"modules-center": [   
	"temperature",
	"cpu",
	"memory",
	"custom/gpu-usage",

],

"modules-right": [
    	"tray",
	"mpd",
     	"pulseaudio",
    	"keyboard-state",
    	"hyprland/submap",
    	"inhibitor",
//	"idle_inhibitor",
	"network",
	"clock"],
//	 "wireplumber",
//	 "cava",
//   	"mpris",
//"pulseaudio/slider#out",
//"pulseaudio/slider#in",
//"systemd-failed-units",
//"custom/disks",



///////////////////////////////////////////////////////////////////////////////////////
     //Modules configuration

///////////////////////////////////////////////////////////////////////////////////////

"hyprland/workspaces": {
      "format": "{name} {windows}",
      "enable-bar-scroll": true,
      "all-outputs": false,
      "move-to-monitor": true,
      "show-special": true,
      "on-click": "activate",
      "expand": false,
      "workspace-taskbar": {
	 	"enable": true,
	 	"format": "{icon}",
	 	"icon-theme": "Papirus",
	 	"icon-size": 16,
	 	"on-click-window": "hyprctl eval \"hl.dispatch(hl.dsp.focus({ window = 'address:{address}' }))\"",
	 	},
     "tooltip": true, 
     "tooltips": {
     		"default": "{workspace}: {windows}",
     		"empty": "",
     			},
     "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
     "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
},


///////////////////////////////////////////////////////////////////////////////////////


"ext/workspaces": {
	"format": "{name} {icon}",
	"on-click": "activate",
	"on-click-right": "close",
	"sort-by-id": true
},



///////////////////////////////////////////////////////////////////////////////////////  
"hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },


///////////////////////////////////////////////////////////////////////////////////////



"wlr/taskbar": {
	"all-outputs": false,
	//"markup": true,
	//"max-length": 10,
	"sort-by-app-id": true,
	"truncate": false,
	"format": "{icon}",
	"expand": true,
	"icon-size": 16,
	"icon-theme": "Papirus",
	//"bar-css-states": true,
	"tooltip": true, 
	"tooltip-format": "{title}",
	"on-click": "activate",
	"on-click-right": "close",
	//"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({window=\"e+1\"})' ",
        //"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({window=\"e-1\"})' ",
	
},


///////////////////////////////////////////////////////////////////////////////////////  
"hyprland/window": {
	/*"separate-outputs": true,
	"format": "{icon}",
   	"icon": true,
    	"icon-size": 14,
	/*"expand": false,*/
		
    },


///////////////////////////////////////////////////////////////////////////////////////

"mpd": {
	"format": "   {volume} {stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}",
	"format-disconnected": "  Disconnected",
	"format-stopped": "  {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}",
	"interval": 5,
	"unknown-tag": "",
	"justify": "center",
	"consume-icons": {
		"on": "  " // Icon shows only when "consume" is on
	},
	"random-icons": {
		"on": "  "
	},
	"repeat-icons": {
		"on": "  "
	},
	"single-icons": {
		"on": "  "		
	},
	"state-icons": {
		"paused":"",
		"playing":""
	},
	//"tooltip-format": "MPD (connected)",
	"tooltip-format": "Music Player Daemon\t{elapsedTime:%M:%S} / {totalTime:%M:%S}\n{artist} - {album}\n{title}\n{filename}",
	"tooltip-format-disconnected": "Music Player Daemon\nDisconnected :(",
	
	"on-click": "mpc toggle",
	"on-scroll-up": "mpc vol +5",
	"on-scroll-down": "mpc vol -5",
	"on-click-forward": "mpc prev",
	"on-click-backward": "mpc next",
	
	"menu": "on-click-right",
	"menu-file": "~/.config/waybar/mpd-menu.xml",
	"menu-actions": {
		"stop": "mpc stop",
		"repeat": "mpc repeat",
		"random": "mpc random",
		"single": "mpc single",
		"singleonce": "mpc single once",
		"consume": "mpc consume",
		"update": "mpc update",
		"ncmpcpp": "app2unit -- kitty -e ncmpcpp",
		"cava": "app2unit -- kitty -e cava",
			},
},

///////////////////////////////////////////////////////////////////////////////////////

"mpris": {
	"format": "{player_icon}",
	//"format": "{player_icon} {dynamic}",
	//"format-paused": "{status_icon} <i>{dynamic}</i>",
	"format-paused": "{status_icon}",
	"player-icons": {
		"default": "▶",
		"mpv": "🎵"
	},
	"status-icons": {
		"paused": "⏸"
	},
	// "ignored-players": ["firefox"]
},



///////////////////////////////////////////////////////////////////////////////////////  	

"wireplumber": {
   	"format": "{volume}% {icon}",
    "format-muted": "{volume}% 󰅶",
    "format-icons": {
            "default": ["", "", ""]
        },
    "on-click": "qpwgraph",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
//    "scroll-ste"menu": "on-click-right",
	"menu-file": "~/.config/waybar/mpd-menu.xml",
	"menu-actions": {
//		"stop": "mpc stop",p": 5, // % can be a float
//	"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
//	"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
	"max-volume": 100,
},

//"wireplumber#source": {
//    "node-type": "Audio/Source",
//    "format": "{volume}% ",
//    "format-muted": "{volume}% ",
//    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
//    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
//    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
//},
},



///////////////////////////////////////////////////////////////////////////////////////
    "pulseaudio": {
    	"max-volume": 100,
        "scroll-step": 5, // %, can be a float
        "format": "{icon}{volume}",
//        "format-bluetooth": "{volume}% {icon} {format_source}",
//        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {volume}",
//        "format-source": "{volume}% ",
//        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", " "]
        },
        "on-click": "app2unit -S out -- pavucontrol --tab=1",
        "on-click-backward": "pamixer --toggle-mute",
                
        "menu": "on-click-right",
	"menu-file": "~/.config/waybar/pulseaudio-menu.xml",
	"menu-actions": {
		"au": "app2unit -- kitty -e audio-detective™.sh",
		"qpwgraph": "app2unit -- qpwgraph",
		"pw-top": "app2unit -- kitty -e pw-top",
			},
    },


///////////////////////////////////////////////////////////////////////////////////////
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " {signalStrength}<span size=\"smaller\">%</span>",
        "format-ethernet": "{ipaddr}/{cidr}  ",
        "tooltip-format": "{ifname}\n{essid}\n{ipaddr} /{cidr}\n{gwaddr}",
        "format-linked": "{ifname} (No IP)   ",
        "format-disconnected": "..󱍢..",
        //"format-alt": "{ifname}: "
        "on-click": "pidof wpa_gui || app2unit -S out -- wpa_gui -i wlp38s0 -m 5 -q",
	
	"menu": "on-click-right",
	"menu-file": "~/.config/waybar/network-menu.xml",
	"menu-actions": {
		"eth": "app2unit -- kitty -e ethstatus -i wlp38s0 -v vga",
		"modem": "app2unit -- brave-browser --new-window 192.168.0.1",
		},
    },



///////////////////////////////////////////////////////////////////////////////////////
"keyboard-state": {
        "numlock": true,
        "capslock": true,
        "scrolllock": false,
        "format": "{name}",
        "format-icons": {
        	"locked": "  ",
		"unlocked": "  "
        		},        	
    },
///////////////////////////////////////////////////////////////////////////////////////

"hyprland/submap": {
	"format": "{}",
	"max-length": 15,
	"tooltip": true,
	"always-on": false,
	"expand": true, 
},


///////////////////////////////////////////////////////////////////////////////////////    
"clock": {
	//"max-length": 30,
	"interval": 60,
	"format": "{:%R}",
	"format-alt": " {:%A, %B %d}",
	"tooltip-format": "<tt><big>{calendar}</big></tt>",
	"calendar": {
		"mode"             : "month",
		"mode-mon-col"     : 3,
		"first-day-of-week": 1,
		"on-scroll"        : 1,
		"on-click-right"   : "mode",
		"format": {
			"months":     "<span color='#ffead3'><b>{}</b></span>",
			"days":       "<span color='#ecc6d9'><b>{}</b></span>",
			"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			"today":      "<span color='#ff6699'><b>{}</b></span>"
		}
	},
	"actions": {
		"on-click-right": "mode",
		"on-click-forward": "tz_up",

		"on-click-backward": "tz_down",
		"on-scroll-up": "shift_down",
		"on-scroll-down": "shift_up"
	},
},


///////////////////////////////////////////////////////////////////////////////////////
"tray": {
        // "icon-size": 21,
        "spacing": 10,
        "show-passive-items": true,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    
    
///////////////////////////////////////////////////////////////////////////////////////    
    
"cpu": {
	"interval": 1,
	"format": " {usage}<span size=\"smaller\">%</span>  {avg_frequency}<span size=\"smaller\">G</span>",
	


},

///////////////////////////////////////////////////////////////////////////////////////

"memory": {
	"interval": 30,
	"format": " {used:0.1f}<span size=\"smaller\">G</span>",
},	

///////////////////////////////////////////////////////////////////////////////////////

 "temperature": {
	// "thermal-zone": 2,
	"hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
	"interval": 1,
	"tooltip-format": "{temperatureC}°C\n{temperatureF}°F\n{temperatureK}°K",
	"warning-threshold": 60,
	"critical-threshold": 80,
		"format": " {temperatureC}°<span size=\"smaller\">C</span>",
	"format-warning": " {temperatureC}°<span size=\"smaller\">C</span>",
	"format-critical": " {temperatureC}°<span size=\"smaller\">C</span>",
	"on-click": "app2unit -T -- btop",
	"menu": "on-click-right",
	"menu-file": "~/.config/waybar/cpu-menu.xml",
	"menu-actions": {
		"btop": "app2unit -T -- btop",
		"htop": "app2unit -T -- htop",
		"sens": "app2unit -T -- sens",
		"gputopcli": "app2unit -T -- amdgpu_top",
		"gputopgui": "app2unit -- amdgpu_top --gui",
		"cpux": "app2unit -- cpu-x",
		"corectrl": "app2unit -- corectrl",
		"lact": "app2unit -- lact gui",
		"radeontop": "app2unit -T -- radeontop",
		"nvtop": "app2unit -T -- nvtop",
		},
},
///////////////////////////////////////////////////////////////////////////////////////

"custom/gpu-usage": {
  "format": "{}", /* "{text} {icon}" for nightly users */
  "exec": "gpu-usage-waybar",
  "return-type": "json",
  "format-icons": "",
  "tooltip": false,
  "on-click": "app2unit -T -- nvtop",
  	"menu": "on-click-right",
	"menu-file": "~/.config/waybar/gpu-menu.xml",
	"menu-actions": {
		"gputopcli": "app2unit -T -- amdgpu_top",
		"gputopgui": "app2unit -- amdgpu_top --gui",
		"lact": "app2unit -- lact gui",
		"radeontop": "app2unit -T -- radeontop",
		"nvtop": "app2unit -T -- nvtop",
		},
},

///////////////////////////////////////////////////////////////////////////////////////
"idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "},
         "tooltip-format-activated": "Presentation mode ON",
         "tooltip-format-deactivated": "Presentation mode OFF",
         
    },

///////////////////////////////////////////////////////////////////////////////////////


"inhibitor": {
	"what": [ "sleep", "shutdown"],
	"format": "{icon}",
	"format-icons": {
		"activated": "  ",
		"deactivated": "  ",
			},
	"tooltip": true,
//	"menu": "on-click-right",
//	"menu-file": "~/.config/waybar/power-menu.xml",
//	"menu-actions": {
//		"lock": "pidof hyprlock || app2unit -- hyprlock -q",
//		"logout": "uwsm stop",
//		"suspend": "pidof hyprlock || app2unit -- hyprlock -q && sleep 2 && systemctl suspend",
//		"softreboot": "syssrb",
//		"reboot": "sysrb",
//		"shutdown": "sysoff",
//			},
},
///////////////////////////////////////////////////////////////////////////////////////

"cava": {
	"cava_config": "$XDG_CONFIG_HOME/cava/waybar_cava_raw.conf",
	"framerate": 30,
	"autosens": 1,
	//"sensitivity": 100,
	"bars": 14,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
	"method": "pulse",
	"source": "auto",
	"stereo": true,
	"reverse": false,
	"monstercat": false,
	"waves": false,
	"noise_reduction": 0.77,
	"input_delay": 2,
	"format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	"actions": {
		"on-click-right": "mode"
	}
},


///////////////////////////////////////////////////////////////////////////////////////
// CAVA GLSL

"cavaGL": {
        "cava_config": "$XDG_CONFIG_HOME/cava/waybar_cava_glsl.conf",
        "input_delay": 2,
        "actions": {
                   "on-click-right": "mode"
                   }
        },

///////////////////////////////////////////////////////////////////////////////////////


"systemd-failed-units": {
	"hide-on-ok": false,
	"format": "✗ {nr_failed}",
	"format-ok": "✓",
	"system": true,
	"user": false,
	"tooltip-format": "{nr_failed} failed units:n{failed_units_list}",
	"tooltip-unit-format": "{scope}: {name} ({active_state})",
},


///////////////////////////////////////////////////////////////////////////////////////

"custom/disks": {
	"format" : "   ",
	"tooltip": true,
	"tooltop-format": "mount and unmount disks",
	"menu": "on-click",
	"menu-file": "~/.config/waybar/disks_menu.xml",
	"menu-actions": {
		"mount1tb": "udmounts mount /dev/sdb1",
		"unmount1tb": "udmounts unmount /dev/sdb1",
		"mountdata": "udmounts mount /dev/sdd1",
		"unmountdata": "udmounts unmount /dev/sdd1",
		"mount3tb": "udmounts mount /dev/sdc1",
		"unmount3tb": "udmounts unmount /dev/sdc1",
	},
},
}
