{
    "label" : "lock",
    "action" : "pidof hyprlock || app2unit -- hyprlock -q",
    "text" : "Lock",
    "keybind" : ""
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : ""
}
{
    "label" : "logout",
    "action" : "uwsm stop",
    "text" : "Logout",
    "keybind" : ""
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : ""
}
{
    "label" : "suspend",
    "action" : "pidof hyprlock || app2unit -- hyprlock -q && sleep 2 && systemctl suspend",
    "text" : "Suspend",
    "keybind" : ""
}
{
    "label" : "softreboot",
    "action" : "systemctl soft-reboot",
    "text" : "SReboot",
    "keybind" : ""
}
