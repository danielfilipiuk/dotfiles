<?xml version="1.0" encoding="utf-8"?>
<note version="0.3" xmlns:link="http://beatniksoftware.com/tomboy/link" xmlns:size="http://beatniksoftware.com/tomboy/size" xmlns="http://beatniksoftware.com/tomboy">
  <title>GIT commands</title>
  
<text xml:space="preserve"><note-content version="0.1"><underline>GIT commands</underline>

#basic commands to upload changes.
git status
git add .
git status
git commit -m " "
git status

#to check database sizes:
git count-objects -vH

# Safety net
git branch backup-before-clean

# Go back to the last good commit while keeping your files
git reset --soft 618ac33

# Unstage everything
git restore --staged .

# Now permanently remove unreachable objects
git reflog expire --expire=now --all
git gc --prune=now --aggressive

</note-content></text>
