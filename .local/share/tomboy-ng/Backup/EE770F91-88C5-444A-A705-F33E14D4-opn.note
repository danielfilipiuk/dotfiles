<note version="0.3" xmlns:link="http://beatniksoftware.com/tomboy/link" xmlns:size="http://beatniksoftware.com/tomboy/size" xmlns="http://beatniksoftware.com/tomboy">
  <title>GTA4 COMMAND LINE</title>
  
<text xml:space="preserve"><note-content version="0.1"><underline>GTA4 COMMAND LINE</underline>
-nomemrestrict -norestrictions -forcehighqualitymirrors -fullspecaudio -frameLimit 1 -managed -reservedapp 0 -highorFPS -availablevidmem 4096

gamescope -W 1280 -H 1024 --rt -O DP-1 -f -- env WINEDLLOVERRIDES="dinput8=n,b" %command% -nomemrestrict -norestrictions -scOfflineOnly -fullspecaudio -forcehighqualitymirrors
</note-content></text>
