  <title>Variables steam</title>
  
<text xml:space="preserve"><note-content version="0.1"><underline>Variables steam</underline>

gamescope -W 1280 -H 1024 -r 60 -s 2 --rt -e -- %command%

gamescope -W 1280 -H 1024 -r 60 -s 1.5 --rt --mangoapp -O DP-1 -f -- %command%

original de GTA4

WINEDLLOVERRIDES="dinput8=n,b" __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1 -nomemrestrict -norestrictions -forcehighqualitymirrors -fullspecaudio -frameLimit 1 -managed -reservedapp 0 -highforFPS -availablevidmem 4096

gamescope -W 1280 -H 1024 -r 60 -f --rt -- %command%

para skyrim?

PROTON_DXVK_LOWLATENCY=1 PROTON_ENABLE_WAYLAND=1 PROTON_USE_WAYLAND=1 PROTON_ENABLE_HDR=1 DXVK_HDR=1 ENABLE_HDR_WSI=1 %command%

gamescope -W 1280 -H 1024 -r 60 --rt -O DP-1 -f --
