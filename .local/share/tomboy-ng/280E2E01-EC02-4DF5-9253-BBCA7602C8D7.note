<?xml version="1.0" encoding="utf-8"?>
<note version="0.3" xmlns:link="http://beatniksoftware.com/tomboy/link" xmlns:size="http://beatniksoftware.com/tomboy/size" xmlns="http://beatniksoftware.com/tomboy">
  <title>checklist procesos</title>
  
<text xml:space="preserve"><note-content version="0.1"><underline>checklist procesos</underline>

"Did Fuzzel find the application?"
ls ~/.local/share/applications/
"Did the desktop entry parse correctly?"
desktop-file-validate ~/.local/share/applications/foo.desktop
"Did app2unit create the service?"
systemctl --user
"Did systemd start it?"
systemctl --user status app-foo@....service
"Is the process actually running?"
ps -ef
"What did the application say?"
journalctl --user -u app-foo@....service

</note-content></text>
