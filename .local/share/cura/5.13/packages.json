        "SpoonAntiWarpingReborn": {
            "filename": "/home/daniel/.cache/cura/5.10/cura_packages/SpoonAntiWarpingReborn.curapackage",
            "package_info": {
                "author": {
                    "author_id": "SlasheeTheCow",
                    "display_name": "Slashee the Cow",
                    "email": "slasheethecow@gmail.com",
                    "website": "https://github.com/slashee-the-cow"
                },
                "description": "Helps prevent warping by creating \"spoons\" which help anchor parts of your print, without having to put like 20 brims around the whole thing. Let the automatic function place spoons on all the important corners of your shape, do it yourself - or a bit of both! Don't like where a spoon is pointed? Just select it like a normal model and rotate it.\n\nThe spoons are easy to remove from most materials and shouldn't leave any visible scarring. You can customise the size of the handle and the spoon itself (affecting the \"grab\" and \"pull\" they have) or use a teardrop shape which goes straight out to the spoon for a larger footprint on the build plate.\n\nYou can set the spoons to print before (or after) all the objects in the scene.\n\nUnlike the \"Tab Anti-Warping Reborn\" it doesn't use support settings. Spoons don't get in the way of any settings!\n\nOriginally created by 5@xes. For the Reborn version, I've updated and optimised all the code and made sure it works on newer versions of Cura.",
                "display_name": "Spoon Anti-Warping Reborn",
                "is_active": true,
                "is_bundled": false,
                "is_installed": true,
                "package_id": "SpoonAntiWarpingReborn",
                "package_type": "plugin",
                "package_version": "1.1.3",
                "sdk_version": 8,
                "sdk_version_semver": "8.10.0",
                "website": "https://github.com/Slashee-the-Cow/SpoonAntiWarpingReborn/"
            }
        },
