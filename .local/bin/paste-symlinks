#!/usr/bin/env bash

set -euo pipefail

# Destination directory.
# If one is passed as an argument, use it.
# Otherwise use the current shell directory.
DEST="${1:-$PWD}"

created=0
failed=0

wl-paste --type text/uri-list 2>/dev/null |
while IFS= read -r uri; do
    [[ "$uri" =~ ^file:// ]] || continue

    # Decode URI
    path="${uri#file://}"
    path=$(printf '%b' "${path//%/\\x}")

    [ -e "$path" ] || continue

    name=$(basename "$path")

    if ln -sr "$path" "$DEST/$name"; then
        ((created++))
    else
        ((failed++))
    fi
done

notify-send \
    "Paste as symbolic links" \
    "Created: $created    Failed: $failed"
