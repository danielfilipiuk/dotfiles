#!/usr/bin/bash

if pgrep -x wlclock >/dev/null; then
    pkill -SIGINT -x wlclock
    exit 0
fi

exec wlclock \
    --namespace wlclock \
    --layer overlay \
    --corner-radius 360 \
    --background-colour "#137A7Fbf" \
    --border-colour "#E12885aaj" \
    --border-size 7 7 7 7 \
    --clock-colour "#FDF6E3cc" \
    --hand-width 10 \
    --marking-width 5 \
    --margin 1 1 1 1 \
    --size 600 &


