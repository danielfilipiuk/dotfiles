#!/usr/bin/bash

if pgrep -x wlclock >/dev/null; then
    pkill -SIGINT -x wlclock
    exit 0
fi

exec wlclock \
    --namespace wlclock \
    --layer top \
    --corner-radius 1000 \
    --background-colour "#231a31bb" \
    --border-colour "#ca9ee6" \
    --border-size 3 3 3 3 \
    --clock-colour "#dddcd8cc" \
    --hand-width 5 \
    --marking-width 3 \
    --margin 3 3 3 3 \
    --size 500 &


