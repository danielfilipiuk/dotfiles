#!/usr/bin/bash

if pgrep -x wlclock >/dev/null; then
    pkill -SIGINT -x wlclock
    exit 0
fi

exec wlclock \
    --namespace wlclock \
    --layer overlay \
    --corner-radius 360 \
    --background-colour "#b57daabf" \
    --border-colour "#b57daaa6" \
    --border-size 3 3 3 3 \
    --clock-colour "#dddcd8cc" \
    --hand-width 10 \
    --marking-width 5 \
    --margin 1 1 1 1 \
    --size 600 &


