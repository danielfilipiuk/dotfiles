#!/bin/sh

# Define your wallpaper directory
#WALLPAPER_DIR="$HOME/pictures/hyprwallpaper"
WALLPAPER_DIR="/mnt/500G/hyprwallpaper/"

# Ensure the directory exists
if [ ! -d "$WALLPAPER_DIR" ]; then
    echo "Directory $WALLPAPER_DIR does not exist." >&2
    exit 1
fi

# Configuration
#Possible values:
#	no:       Do not resize the image
#	crop:     Resize the image to fill the whole screen, cropping out parts that don't fit
#	fit:      Resize the image to fit inside the screen, preserving the original aspect ratio
#	stretch:  Resize the image to fit inside the screen, without preserving the original aspect ratio
RESIZE_TYPE="crop"
export AWWW_TRANSITION_FPS=60
export AWWW_TRANSITION_STEP=20

# Get a list of all active displays from awww query
DISPLAYS=$(awww query | awk '{print $2}' | sed 's/://')

for d in $DISPLAYS; do
    # Pick a random image from the directory for this display
    # (Using shuf is significantly faster and cleaner than sorting /dev/urandom)
    IMG=$(find "$WALLPAPER_DIR" -type f | shuf -n 1)
    
    if [ -n "$IMG" ]; then
        # Use uwsm-app to scope the command inside your Wayland session if needed
        app2unit -S out -- awww img \
            --resize "$RESIZE_TYPE" \
            --outputs "$d" \
            --crop-gravity=center \
            --transition-type=random \
            --transition-duration=10 \
            --transition-fps=60 \
            --fill-color 00000000 \
            "$IMG"
    fi
done
