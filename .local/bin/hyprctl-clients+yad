#!/bin/bash

# inspiration taken from the cool dotfiles in  https://github.com/OpalAayan/opaldots/tree/main

# --- Check dependencies ---
if ! command -v yad &>/dev/null; then
    #echo "YAD is not installed. Try: sudo apt install yad"
    notify-send -i Warning "Yad is NOT installed." -u critical -i emblem-unavailable
    exit 1
fi


# --- Main loop ---
while true; do

    hyprctl clients | yad --text-info \
        --title="Hyprland Window Properties" \
        --margins=15 \
        --class="hyprprop+yad" \
        --window-icon="display" \
        --width=520 \
        --height=850 \
        --posx=50% \
        --posy=50% \
        --buttons-layout="center" \
        --button="❌ Exit:0" \
        --button="🔲 Scan Again:1" \
        --on-top \
        --image="$HOME/pictures/hyprland/hypr.png" \
        --image-on-top \
        --center

    case $? in
        1)
            # Capture → loop again
            ;;
        *)
            # Close / ESC
            exit 0
            ;;
    esac

done
