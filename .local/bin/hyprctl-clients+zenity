#!/bin/bash

# --- Check dependencies ---
if ! command -v zenity &>/dev/null; then
    #echo "Zenity is not installed. Try: sudo apt install yad"
    notify-send -i Warning "Zenity is NOT installed." -u critical -i emblem-unavailable
    exit 1
fi

# --- Main loop ---
while true; do

    hyprctl clients | zenity --text-info \
        --title="Hyprland Window Properties" \
        --width=520 \
        --height=850 \
        --auto-scroll 

    case $? in
        0)
            # Capture → loop again
            ;;
        1)
            # Close / ESC
            exit 0
            ;;
    esac

done
