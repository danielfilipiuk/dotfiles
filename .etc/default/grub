# If you change this file, run 'update-grub' afterwards to update
# /boot/grub/grub.cfg.
# For full documentation of the options in this file, see:
#   info -f grub -n 'Simple configuration'

GRUB_DEFAULT=1
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`

GRUB_CMDLINE_LINUX_DEFAULT="hostname=POLARIS vt.cur_default=0x8 loglevel=3 consoleblank=300 amd_pstate=active noresume"

GRUB_CMDLINE_LINUX=""

GRUB_DISABLE_OS_PROBER=true

#GRUB_TERMINAL=console

GRUB_TERMINAL="gfxterm"

GRUB_GFXPAYLOAD_LINUX=keep

# The resolution used on graphical terminal
# note that you can use only modes which your graphic card supports via VBE
# you can see them in real GRUB with the command `vbeinfo'
GRUB_GFXMODE="1280x1024,auto"

GRUB_DISABLE_SUBMENU="true"
GRUB_DISABLE_RECOVERY="true"

#GRUB_INIT_TUNE="480 440 1"

GRUB_DISABLE_EFI="true"

# Fonts:

GRUB_FONT=/boot/grub/fonts/jbmnf-regular-18.pf2

#GRUB_FONT=/boot/grub/fonts/unifont-16.pf2
#GRUB_FONT=/boot/grub/fonts/terminus-18.pf2

#GRUB_BACKGROUND=/opt/grub-black-big.png
#GRUB_BACKGROUND="/opt/grub-waves.png"
#GRUB_THEME="/usr/share/grub/themes/Graphitenord/theme.txt"

GRUB_THEME="/usr/share/grub/themes/ceratopsian-mod/theme.txt"
